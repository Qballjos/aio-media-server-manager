# Local-only origin for Cloudflare Tunnel → Jellyfin.
# cloudflared often sends CF-Connecting-IP but Jellyfin only trusts X-Forwarded-For
# from KnownProxies (127.0.0.1). This shim copies CF-Connecting-IP into XFF so
# RemoteClientBitrateLimit and IsInLocalNetwork see the real client, not loopback.
#
# Placeholders filled at start: __LISTEN_PORT__ __UPSTREAM_PORT__ __ERROR_LOG__
# LAN clients keep using Jellyfin on the upstream port directly. Do not publish the listen port.

worker_processes 1;
error_log __ERROR_LOG__ warn;
pid /tmp/jellyfin-cf-origin.pid;

events {
    worker_connections 1024;
}

http {
    access_log off;
    client_max_body_size 0;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_http_version 1.1;
    sendfile on;
    tcp_nodelay on;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # Prefer Cloudflare's client IP; fall back to any XFF cloudflared already set.
    map $http_cf_connecting_ip $jellyfin_client_ip {
        ~.      $http_cf_connecting_ip;
        default $http_x_forwarded_for;
    }

    server {
        listen 127.0.0.1:__LISTEN_PORT__;
        listen [::1]:__LISTEN_PORT__;

        location / {
            proxy_pass http://127.0.0.1:__UPSTREAM_PORT__;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $jellyfin_client_ip;
            proxy_set_header X-Forwarded-For $jellyfin_client_ip;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
        }
    }
}
