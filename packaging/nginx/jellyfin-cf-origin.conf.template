# Local-only origin for Cloudflare Tunnel → Jellyfin.
# cloudflared may send CF-Connecting-IP; Jellyfin only honors X-Forwarded-For from
# KnownProxies. Use real_ip so $remote_addr becomes the client, then pass that as XFF.
#
# Placeholders: __LISTEN_PORT__ __UPSTREAM_PORT__ __ERROR_LOG__ __ACCESS_LOG__
# LAN clients keep using Jellyfin on the upstream port directly. Do not publish the listen port.

worker_processes 1;
error_log __ERROR_LOG__ warn;
pid /tmp/jellyfin-cf-origin.pid;

events {
    worker_connections 1024;
}

http {
    access_log off;
    client_max_body_size 0;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_http_version 1.1;
    sendfile on;
    tcp_nodelay on;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # cloudflared is the only peer (loopback). Trust it for CF-Connecting-IP → $remote_addr.
    set_real_ip_from 127.0.0.0/8;
    set_real_ip_from ::1;
    real_ip_header CF-Connecting-IP;
    real_ip_recursive on;

    log_format cf_debug '$remote_addr cf=$http_cf_connecting_ip '
                        'xff_in=$http_x_forwarded_for host=$host';
    access_log __ACCESS_LOG__ cf_debug;

    server {
        listen 127.0.0.1:__LISTEN_PORT__;

        # Open https://media.example.com/aio-xff-debug to see what the shim receives.
        location = /aio-xff-debug {
            default_type text/plain;
            return 200 "remote_addr=$remote_addr\ncf_connecting_ip=$http_cf_connecting_ip\ntrue_client_ip=$http_true_client_ip\nxff_in=$http_x_forwarded_for\n";
        }

        location / {
            proxy_pass http://127.0.0.1:__UPSTREAM_PORT__;
            proxy_set_header Host $host;
            # After real_ip, $remote_addr is the browser IP when CF-Connecting-IP was set.
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
        }
    }
}
