# ============================================================
# AIO Media Manager — Environment Configuration Example
# Copy this file to .env and adjust values for your system.
# ============================================================

# ----------------------------------------------------------
# Storage Paths
# ----------------------------------------------------------
# Where app config files and logs are stored.
# In Docker: map your host path to /config
AMM_CONFIG_DIR=/config

# Where downloaded media lands (before moving to media dir).
# In Docker: map your host path to /downloads
AMM_DOWNLOAD_DIR=/downloads

# Final media library location.
# In Docker: map your host path to /media
AMM_MEDIA_DIR=/media

# ----------------------------------------------------------
# User / Permission
# ----------------------------------------------------------
# UID and GID that supervised child processes will run as.
# Set to your host user's UID/GID to avoid permission issues.
# Run `id` on your host to find your values.
PUID=1000
PGID=1000

# ----------------------------------------------------------
# API Server
# ----------------------------------------------------------
AMM_API_HOST=0.0.0.0
AMM_API_PORT=8080

# ----------------------------------------------------------
# Logging
# ----------------------------------------------------------
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
AMM_LOG_LEVEL=INFO

# ----------------------------------------------------------
# Backups
# ----------------------------------------------------------
# AMM_BACKUP_DIR=/config/backups
# AMM_BACKUP_RETENTION=7

# ----------------------------------------------------------
# Reverse proxy (optional)
# ----------------------------------------------------------
# Comma-separated proxy IPs. Empty = use http://server-ip:port directly.
# AMM_TRUSTED_PROXIES=10.0.0.1,172.16.0.0/12
# AMM_ROOT_PATH=

# ----------------------------------------------------------
# VPN (qBittorrent only — Usenet bypasses the tunnel)
# ----------------------------------------------------------
# AMM_VPN_ENABLED=false
# AMM_VPN_ENFORCE=false
# AMM_VPN_PROVIDER=privadovpn
# AMM_VPN_PROTOCOL=wireguard
# AMM_VPN_CONFIG=/config/vpn/wg0.conf

# ----------------------------------------------------------
# Cloudflare Tunnel (optional — cloudflared inside this appliance)
# ----------------------------------------------------------
# Create a remotely managed tunnel in Cloudflare Zero Trust, add a published
# application to http://127.0.0.1:8080, then enable:
# AMM_CLOUDFLARE_TUNNEL_ENABLED=true
# Prefer a token file (0600) over putting the token in compose:
# AMM_CLOUDFLARE_TUNNEL_TOKEN_FILE=/config/cloudflare/tunnel.token
# AMM_CLOUDFLARE_TUNNEL_TOKEN=
# AMM_CLOUDFLARE_TUNNEL_METRICS=127.0.0.1:2000

# ----------------------------------------------------------
# GitHub API (optional)
# ----------------------------------------------------------
# Raises GitHub release download rate limits during app installs.
# GITHUB_TOKEN=
