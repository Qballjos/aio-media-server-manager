# AIO Media Server Manager — environment example
# Copy to .env for a native Linux / LXC install. Compose bind-mounts
# $HOME/aio-media-manager to /data and sets in-container download/media paths.
# Prefer Settings in the UI after first-run for timezone, GitHub token, VPN,
# and update schedules.

# ----------------------------------------------------------
# Storage Paths
# ----------------------------------------------------------
# Where app config files and logs are stored.
# In Docker: map your host path to /config
AMM_CONFIG_DIR=/config

# Where downloaded media lands (before moving to media dir).
# Native Linux: keep downloads and media as siblings in your home so the
# file manager can see them (same filesystem so *Arr can hardlink):
AMM_DOWNLOAD_DIR=~/aio-media-manager/downloads

# Final media library location.
AMM_MEDIA_DIR=~/aio-media-manager/media
# Docker: compose bind-mounts $HOME/aio-media-manager to /data and sets
# AMM_DOWNLOAD_DIR=/data/downloads and AMM_MEDIA_DIR=/data/media inside the container.

# ----------------------------------------------------------
# User / Permission
# ----------------------------------------------------------
# UID and GID that supervised child processes will run as.
# Set to your host user's UID/GID to avoid permission issues.
# Run `id` on your host to find your values.
PUID=1000
PGID=1000

# ----------------------------------------------------------
# API Server
# ----------------------------------------------------------
AMM_API_HOST=0.0.0.0
AMM_API_PORT=8080

# ----------------------------------------------------------
# Logging and timezone
# ----------------------------------------------------------
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
AMM_LOG_LEVEL=INFO
# Host timezone for logs, the dashboard clock, and scheduled updates.
# Settings → System can change this after first-run (persisted in amm_config.json).
# TZ=Europe/Amsterdam
# AMM_TIMEZONE=Europe/Amsterdam

# ----------------------------------------------------------
# Backups
# ----------------------------------------------------------
# Default: /backups when it is a mounted volume, else /config/backups.
# AMM_BACKUP_DIR=/backups
# AMM_BACKUP_RETENTION=7
# off | daily | weekly | monthly (host timezone)
# AMM_BACKUP_SCHEDULE=daily
# AMM_BACKUP_TIME=03:30
# AMM_BACKUP_WEEKDAY=0
# AMM_BACKUP_DAY=1

# ----------------------------------------------------------
# Reverse proxy (optional)
# ----------------------------------------------------------
# Comma-separated proxy IPs. Empty = use http://server-ip:port directly.
# AMM_TRUSTED_PROXIES=10.0.0.1,172.16.0.0/12
# DNS zone for Catalog Open UI over HTTPS/Cloudflare (https://sonarr.example.com).
# AMM_PUBLIC_APP_BASE_DOMAIN=example.com
# AMM_ROOT_PATH=

# ----------------------------------------------------------
# VPN (qBittorrent, Prowlarr, Flaresolverr — Usenet bypasses the tunnel)
# Also Settings → Network after first-run.
# ----------------------------------------------------------
# AMM_VPN_ENABLED=false
# Kill switch is always on while VPN is enabled (Prowlarr + qBittorrent cannot use the house WAN).
# AMM_VPN_ENFORCE=true
# AMM_VPN_PROVIDER=privadovpn
# AMM_VPN_PROTOCOL=wireguard
# AMM_VPN_CONFIG=/config/vpn/wg0.conf

# ----------------------------------------------------------
# Cloudflare Tunnel (optional — cloudflared inside this appliance)
# ----------------------------------------------------------
# Create a remotely managed tunnel, enable below, then use Settings → Network
# → Public subdomains to choose hostnames and Publish (needs a separate
# Cloudflare API token with Tunnel Edit + DNS Edit — stored in the UI secret store).
# AMM_CLOUDFLARE_TUNNEL_ENABLED=true
# Prefer a token file (0600) over putting the token in compose:
# AMM_CLOUDFLARE_TUNNEL_TOKEN_FILE=/config/cloudflare/tunnel.token
# AMM_CLOUDFLARE_TUNNEL_TOKEN=
# AMM_CLOUDFLARE_TUNNEL_METRICS=127.0.0.1:2000

# ----------------------------------------------------------
# GitHub API (optional)
# ----------------------------------------------------------
# Raises GitHub release download rate limits during installs and scheduled checks.
# Prefer Settings → Updates after first-run (stored in the secret store, not this file).
# GITHUB_TOKEN=

# ----------------------------------------------------------
# Scheduled catalog updates (optional; also Settings → Updates)
# ----------------------------------------------------------
# Check/apply: off | daily | weekly | monthly
# Apply may also be "same" (follow the check schedule).
# AMM_UPDATE_CHECK_SCHEDULE=off
# AMM_UPDATE_APPLY_SCHEDULE=off
# AMM_UPDATE_TIME=04:00
# AMM_UPDATE_WEEKDAY=0
# AMM_UPDATE_DAY=1
