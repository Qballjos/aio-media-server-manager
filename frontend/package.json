{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && \"${E2E_PYTHON:-../.venv/bin/python}\" ../scripts/e2e_server.py --preview",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:posters": "npm run build && playwright test --config playwright.webkit.config.js poster-loading.spec.js",
    "test:webkit": "npm run build && playwright test --config playwright.webkit.config.js"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.23",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@vitejs/plugin-vue": "^6.0.11",
    "vite": "^8.3.8"
  }
}
