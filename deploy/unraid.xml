<?xml version="1.0"?>
<Container>
  <Name>aio-media-manager</Name>
  <Repository>ghcr.io/qballjos/aio-media-server-manager:latest</Repository>
  <Registry>https://ghcr.io/</Registry>
  <Network>bridge</Network>
  <Privileged>true</Privileged>
  <Support>https://github.com/Qballjos/aio-media-server-manager</Support>
  <Overview>
    Single-container AIO media appliance. All *Arr apps, downloaders, and media servers run as supervised processes inside this one container — not as extra containers.
  </Overview>
  <Category>MediaServer:</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <ExtraParams>--device /dev/dri:/dev/dri --cap-add=NET_ADMIN</ExtraParams>
  <Config Name="Manager" Target="8080" Default="8080" Mode="tcp" Type="Port" Display="always"/>
  <Config Name="qBittorrent" Target="8081" Default="8081" Mode="tcp" Type="Port" Display="always"/>
  <Config Name="Shelfmark" Target="8084" Default="8084" Mode="tcp" Type="Port" Display="always"/>
  <Config Name="SABnzbd" Target="8085" Default="8085" Mode="tcp" Type="Port" Display="always"/>
  <Config Name="Jellyfin" Target="8096" Default="8096" Mode="tcp" Type="Port" Display="always"/>
  <Config Name="Flaresolverr" Target="8191" Default="8191" Mode="tcp" Type="Port" Display="always"/>
  <Config Name="Seerr" Target="5055" Default="5055" Mode="tcp" Type="Port" Display="always"/>
  <Config Name="Grimmory" Target="6060" Default="6060" Mode="tcp" Type="Port" Display="always"/>
  <Config Name="Bazarr" Target="6767" Default="6767" Mode="tcp" Type="Port" Display="always"/>
  <Config Name="NZBGet" Target="6789" Default="6789" Mode="tcp" Type="Port" Display="always"/>
  <Config Name="Profilarr" Target="6868" Default="6868" Mode="tcp" Type="Port" Display="always"/>
  <Config Name="Radarr" Target="7878" Default="7878" Mode="tcp" Type="Port" Display="always"/>
  <Config Name="Lidarr" Target="8686" Default="8686" Mode="tcp" Type="Port" Display="always"/>
  <Config Name="Sonarr" Target="8989" Default="8989" Mode="tcp" Type="Port" Display="always"/>
  <Config Name="Prowlarr" Target="9696" Default="9696" Mode="tcp" Type="Port" Display="always"/>
  <Config Name="NeutArr" Target="9705" Default="9705" Mode="tcp" Type="Port" Display="always"/>
  <Config Name="Plex" Target="32400" Default="32400" Mode="tcp" Type="Port" Display="always"/>
  <Config Name="Config" Target="/config" Default="/mnt/user/appdata/aio-media-manager" Mode="rw" Type="Path" Display="always"/>
  <Config Name="Data" Target="/data" Default="/mnt/cache/data" Mode="rw" Type="Path" Display="always"/>
  <Config Name="Backups" Target="/backups" Default="/mnt/user/backups/aio-media-manager" Mode="rw" Type="Path" Display="always" Description="Configuration backups. Keep on the array, not only on cache."/>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Type="Variable" Display="always"/>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Type="Variable" Display="always"/>
  <Config Name="Download dir" Target="AMM_DOWNLOAD_DIR" Default="/data/downloads" Mode="" Type="Variable" Display="always"/>
  <Config Name="Media dir" Target="AMM_MEDIA_DIR" Default="/data/media" Mode="" Type="Variable" Display="always"/>
  <Config Name="Timezone" Target="TZ" Default="UTC" Mode="" Type="Variable" Display="always"/>
  <Config Name="GitHub token" Target="GITHUB_TOKEN" Default="" Mode="" Type="Variable" Display="advanced"/>
</Container>
