<?xml version="1.0"?>
<Container>
  <Name>aio-media-manager</Name>
  <Repository>ghcr.io/qballjos/aio-media-server-manager:latest</Repository>
  <Registry>https://ghcr.io/</Registry>
  <Network>bridge</Network>
  <Privileged>true</Privileged>
  <Support>https://github.com/Qballjos/aio-media-server-manager</Support>
  <Overview>
    Single-container AIO media appliance. All *Arr apps, downloaders, and media servers run as supervised processes inside this one container — not as extra containers.
  </Overview>
  <Category>MediaServer:</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <ExtraParams>--device /dev/dri:/dev/dri --cap-add=NET_ADMIN</ExtraParams>
  <Config Name="Host Port" Target="8080" Default="8080" Mode="tcp" Type="Port" Display="always"/>
  <Config Name="Config" Target="/config" Default="/mnt/user/appdata/aio-media-manager" Mode="rw" Type="Path" Display="always"/>
  <Config Name="Data" Target="/data" Default="/mnt/cache/data" Mode="rw" Type="Path" Display="always"/>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Type="Variable" Display="always"/>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Type="Variable" Display="always"/>
  <Config Name="Download dir" Target="AMM_DOWNLOAD_DIR" Default="/data/downloads" Mode="" Type="Variable" Display="always"/>
  <Config Name="Media dir" Target="AMM_MEDIA_DIR" Default="/data/media" Mode="" Type="Variable" Display="always"/>
</Container>
