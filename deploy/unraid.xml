<?xml version="1.0"?>
<!--
  Legacy path. Canonical Community Applications template:
  deploy/unraid/templates/aio-media-manager.xml
-->
<Container version="2">
  <Name>aio-media-manager</Name>
  <Repository>ghcr.io/qballjos/aio-media-server-manager:latest</Repository>
  <Registry>https://ghcr.io/qballjos/aio-media-server-manager</Registry>
  <Network>bridge</Network>
  <Shell>bash</Shell>
  <Privileged>true</Privileged>
  <Support>https://github.com/Qballjos/aio-media-server-manager/issues</Support>
  <Project>https://github.com/Qballjos/aio-media-server-manager</Project>
  <Overview>
    One-container media appliance. All *Arr apps, downloaders, and media servers run as supervised processes inside this one container — not as extra containers.
  </Overview>
  <Category>MediaServer:Video MediaApp:Video Downloaders:</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/Qballjos/aio-media-server-manager/main/deploy/unraid/templates/aio-media-manager.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/Qballjos/aio-media-server-manager/main/frontend/public/logo-aio-media-manager.png</Icon>
  <ExtraParams>--cap-add=NET_ADMIN --cap-add=SYS_MODULE</ExtraParams>
  <Config Name="Manager WebUI" Target="8080" Default="8080" Mode="tcp" Description="AIO Media Server Manager UI" Type="Port" Display="always" Required="true" Mask="false">8080</Config>
  <Config Name="qBittorrent" Target="8081" Default="8081" Mode="tcp" Description="qBittorrent WebUI" Type="Port" Display="always" Required="false" Mask="false">8081</Config>
  <Config Name="Shelfmark" Target="8084" Default="8084" Mode="tcp" Description="Shelfmark WebUI" Type="Port" Display="advanced" Required="false" Mask="false">8084</Config>
  <Config Name="SABnzbd" Target="8085" Default="8085" Mode="tcp" Description="SABnzbd WebUI" Type="Port" Display="always" Required="false" Mask="false">8085</Config>
  <Config Name="Jellyfin" Target="8096" Default="8096" Mode="tcp" Description="Jellyfin WebUI" Type="Port" Display="always" Required="false" Mask="false">8096</Config>
  <Config Name="Flaresolverr" Target="8191" Default="8191" Mode="tcp" Description="Flaresolverr" Type="Port" Display="advanced" Required="false" Mask="false">8191</Config>
  <Config Name="Seerr" Target="5055" Default="5055" Mode="tcp" Description="Seerr" Type="Port" Display="always" Required="false" Mask="false">5055</Config>
  <Config Name="Grimmory" Target="6060" Default="6060" Mode="tcp" Description="Grimmory" Type="Port" Display="advanced" Required="false" Mask="false">6060</Config>
  <Config Name="Bazarr" Target="6767" Default="6767" Mode="tcp" Description="Bazarr" Type="Port" Display="always" Required="false" Mask="false">6767</Config>
  <Config Name="NZBGet" Target="6789" Default="6789" Mode="tcp" Description="NZBGet" Type="Port" Display="advanced" Required="false" Mask="false">6789</Config>
  <Config Name="Profilarr" Target="6868" Default="6868" Mode="tcp" Description="Profilarr" Type="Port" Display="advanced" Required="false" Mask="false">6868</Config>
  <Config Name="Radarr" Target="7878" Default="7878" Mode="tcp" Description="Radarr" Type="Port" Display="always" Required="false" Mask="false">7878</Config>
  <Config Name="Lidarr" Target="8686" Default="8686" Mode="tcp" Description="Lidarr" Type="Port" Display="always" Required="false" Mask="false">8686</Config>
  <Config Name="Sonarr" Target="8989" Default="8989" Mode="tcp" Description="Sonarr" Type="Port" Display="always" Required="false" Mask="false">8989</Config>
  <Config Name="Prowlarr" Target="9696" Default="9696" Mode="tcp" Description="Prowlarr" Type="Port" Display="always" Required="false" Mask="false">9696</Config>
  <Config Name="NeutArr" Target="9705" Default="9705" Mode="tcp" Description="NeutArr" Type="Port" Display="advanced" Required="false" Mask="false">9705</Config>
  <Config Name="Plex" Target="32400" Default="32400" Mode="tcp" Description="Plex" Type="Port" Display="always" Required="false" Mask="false">32400</Config>
  <Config Name="Config" Target="/config" Default="/mnt/user/appdata/aio-media-manager" Mode="rw" Description="App settings and child-app config" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/aio-media-manager</Config>
  <Config Name="Data" Target="/data" Default="/mnt/user/aio-media-manager" Mode="rw" Description="downloads/ and media/ share" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/aio-media-manager</Config>
  <Config Name="Backups" Target="/backups" Default="/mnt/user/backups/aio-media-manager" Mode="rw" Description="Configuration backups" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/backups/aio-media-manager</Config>
  <Config Name="Intel/AMD GPU" Target="/dev/dri" Default="" Mode="rw" Description="Optional /dev/dri for transcoding" Type="Device" Display="advanced" Required="false" Mask="false"/>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="Unraid nobody (99)" Type="Variable" Display="always" Required="true" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="Unraid users (100)" Type="Variable" Display="always" Required="true" Mask="false">100</Config>
  <Config Name="Timezone" Target="TZ" Default="UTC" Mode="" Description="IANA timezone" Type="Variable" Display="always" Required="false" Mask="false">UTC</Config>
  <Config Name="Download dir" Target="AMM_DOWNLOAD_DIR" Default="/data/downloads" Mode="" Description="In-container downloads path" Type="Variable" Display="advanced" Required="true" Mask="false">/data/downloads</Config>
  <Config Name="Media dir" Target="AMM_MEDIA_DIR" Default="/data/media" Mode="" Description="In-container media path" Type="Variable" Display="advanced" Required="true" Mask="false">/data/media</Config>
  <Config Name="GitHub token" Target="GITHUB_TOKEN" Default="" Mode="" Description="Optional GitHub API token" Type="Variable" Display="advanced" Required="false" Mask="true"/>
</Container>
